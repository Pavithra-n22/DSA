    public static void longestchracters(String s)
     {int count=0;int max_count=0;
             char[] ch = s.toCharArray();
             HashSet<Character> hset = new HashSet<>();
              int left =0; int right=0;int maxcount=0;
              while(left<=right &&right<ch.length)
                {
                   if(!hset.contains(ch[right]))  
                   {
                       hset.add(ch[right]); 
                      
                       right++;
                        count=right-left;
                                                   
                   }
                    else if(hset.contains(ch[right]))
                             {
                                   hset.remove(ch[left]);
                                    left++;
                                                    
                             }
                    maxcount=Math.max(maxcount,count);                         
                                                
                  }
      System.out.println(maxcount);
            
                             
