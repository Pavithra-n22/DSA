class Main {
    public static void topk(int[] str)
    {  int count =0;
        HashMap<Integer,Integer> hmap = new HashMap<>();
        for(int i =0;i<str.length;i++)
            {    
                if(hmap.containsKey(str[i]))
                {
                    hmap.put(str[i],hmap.get(str[i])+1);
                }
                else
                {
                    hmap.put(str[i],1);
                }
            }
       PriorityQueue<Integer> pq = new PriorityQueue<>((a,b)->hmap.get(a)-hmap.get(b));
       for(int x : hmap.keySet())
           {
               pq.add(x);
               if(pq.size()>2)
               {
                   pq.poll();
               }
           }
       System.out.println(pq);
       
    }
        
    
    
    public static void main(String[] args) {
    int[] str={1,2,3,2,1,1,1,1,13,3,3,3,3,3};
    topk(str);
}}
