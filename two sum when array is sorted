        public static void twosum(int[] arr,int target)
        {
             int left =0; int  right=arr.length-1; 
                while(left<right)
                        {
                                if(arr[left]+arr[right]<target)
                                {
                                        left++;
                                }
                                else if(arr[left]+arr[right]>target)
                                {
                                        right--;
                                }
                             else if(arr[left]+arr[right]==target )
                                {
                                        System.out.println(left +" ,"+ right);
                                        left ++;
                                        right--;
                                }
                               
                        }
        }



        
